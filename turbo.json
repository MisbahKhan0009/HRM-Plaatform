{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "tokens": {
      "inputs": ["scripts/**", "../../docs/02-brand/source/tokens.json"],
      "outputs": ["src/tokens.css"]
    },
    "@hrm/api#build": {
      "dependsOn": ["^build", "@hrm/web#build"],
      "outputs": ["dist/**"]
    },
    "@hrm/api#test": {
      "dependsOn": ["^build", "@hrm/web#build"],
      "outputs": []
    }
  },
  "globalEnv": ["CI"]
}
