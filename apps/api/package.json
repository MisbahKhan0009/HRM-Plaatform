{
  "name": "@hrm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --env production --outdir dist",
    "typecheck": "wrangler types --check --strict-vars=false --env-file .dev.vars.example && tsc -p tsconfig.json",
    "types": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "test": "vitest run",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@hrm/auth": "workspace:*",
    "@hrm/contracts": "workspace:*",
    "@hrm/db": "workspace:*",
    "@hrm/domain": "workspace:*",
    "@hrm/mailer": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.0",
    "@cloudflare/vitest-plugin": "catalog:",
    "@hrm/config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
